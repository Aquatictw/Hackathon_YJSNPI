{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grp6.invalid/contracts/edge-v1.schema.json",
  "title": "grp6 Edge event batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "edge_id", "batch_id", "events"],
  "properties": {
    "schema_version": { "const": 1 },
    "edge_id": { "$ref": "#/$defs/id" },
    "batch_id": { "$ref": "#/$defs/id" },
    "sent_at": { "type": "string", "format": "date-time" },
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "site": { "type": "integer", "minimum": 1, "maximum": 256 },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "type", "source_mode", "run_id", "tester_id", "timestamp"],
      "properties": {
        "event_id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["measurement", "prediction", "prediction_actual", "evidence", "heartbeat", "run_summary"] },
        "source_mode": { "enum": ["live", "replay", "simulation"] },
        "run_id": { "$ref": "#/$defs/id" },
        "tester_id": { "$ref": "#/$defs/id" },
        "lot_id": { "$ref": "#/$defs/id" },
        "wafer_id": { "$ref": "#/$defs/id" },
        "device_id": { "$ref": "#/$defs/id" },
        "site_id": { "$ref": "#/$defs/site" },
        "site_ids": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/site" } },
        "timestamp": { "type": "string", "format": "date-time" },
        "sequence": { "type": "integer", "minimum": 0 },
        "attempt": { "type": "integer", "minimum": 1 },
        "test_number": { "type": "integer" },
        "test_name": { "type": "string", "minLength": 1, "maxLength": 240 },
        "pin": { "type": "string", "maxLength": 120 },
        "value": { "type": "number" },
        "unit": { "type": ["string", "null"], "maxLength": 32 },
        "quality": { "type": "string", "maxLength": 32 },
        "request_id": { "$ref": "#/$defs/id" },
        "original_request_id": { "$ref": "#/$defs/id" },
        "source_event_id": { "$ref": "#/$defs/id" },
        "stage": { "type": "integer", "minimum": 1, "maximum": 6 },
        "prediction": { "type": ["number", "null"] },
        "actual": { "type": "number" },
        "absolute_error": { "type": "number", "minimum": 0 },
        "model_version": { "$ref": "#/$defs/id" },
        "feature_cutoff": { "type": "integer" },
        "latency_ms": { "type": "number", "minimum": 0 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "response_status": { "enum": ["not_requested", "insufficient_data", "response_queued", "tester_confirmed", "unknown"] },
        "tester_receipt_id": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "evidence_id": { "$ref": "#/$defs/id" },
        "incident_id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
        "direction": { "type": "string", "maxLength": 32 },
        "sample_count": { "type": "integer", "minimum": 0 },
        "score": { "type": "number" },
        "baseline": { "type": "number" },
        "current_value": { "type": "number" },
        "threshold": { "type": "number" },
        "affected_tests": { "type": "array", "maxItems": 40, "items": { "type": "string", "minLength": 1, "maxLength": 240 } },
        "series": { "type": "array", "maxItems": 320, "items": { "type": "number" } },
        "site_series": { "type": "object", "additionalProperties": { "type": "array", "maxItems": 320, "items": { "type": "number" } } },
        "suggestion": { "type": "string", "maxLength": 1000 },
        "severity": { "enum": ["info", "warning", "critical"] },
        "message": { "type": "string", "maxLength": 2000 },
        "completed_devices": { "type": "integer", "minimum": 0 },
        "yield": { "type": "number", "minimum": 0, "maximum": 1 },
        "data_quality": { "enum": ["complete", "partial"] },
        "queue_depth": { "type": "integer", "minimum": 0 },
        "version": { "type": "string", "maxLength": 120 }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "measurement" } } }, "then": { "required": ["value", "test_name"] } },
        { "if": { "properties": { "type": { "const": "prediction" } } }, "then": { "required": ["request_id", "stage", "device_id"] } },
        { "if": { "properties": { "type": { "const": "prediction_actual" } } }, "then": { "required": ["request_id", "actual"] } },
        { "if": { "properties": { "type": { "const": "evidence" } } }, "then": { "required": ["evidence_id"] } },
        { "if": { "properties": { "response_status": { "const": "tester_confirmed" } }, "required": ["response_status"] }, "then": { "properties": { "tester_receipt_id": { "$ref": "#/$defs/id" } }, "required": ["tester_receipt_id"] } }
      ]
    }
  }
}
