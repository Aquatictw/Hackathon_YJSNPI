{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/batch",
  "$defs": {
    "event": {
      "type": "object",
      "properties": {
        "type": {
          "const": "event"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "enum": [
            "simulation",
            "replay",
            "live"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tester_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "wafer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "site": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "kind": {
          "enum": [
            "normal",
            "mean_drift",
            "low_yield",
            "missing_data",
            "measurement",
            "prediction",
            "external_evidence",
            "heartbeat",
            "run_summary"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "incident_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "maxItems": 20
        },
        "data_quality": {
          "enum": [
            "complete",
            "partial"
          ]
        }
      },
      "required": [
        "type",
        "event_id",
        "occurred_at",
        "mode",
        "run_id",
        "tester_id",
        "lot_id",
        "wafer_id",
        "site",
        "severity",
        "kind",
        "message",
        "incident_id",
        "evidence_ids",
        "data_quality"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "type": {
          "const": "evidence"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tester_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "wafer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "site": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "test_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "metric": {
          "enum": [
            "mean",
            "yield",
            "coverage",
            "measurement"
          ]
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "index",
              "value"
            ],
            "additionalProperties": false
          },
          "maxItems": 320
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 32
        },
        "site_series": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "maxItems": 320
          }
        },
        "score": {
          "type": "number"
        },
        "suggestion": {
          "type": "string",
          "maxLength": 1000
        },
        "response_status": {
          "enum": [
            "not_requested",
            "insufficient_data",
            "response_queued",
            "tester_confirmed",
            "unknown"
          ]
        },
        "tester_receipt_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "evidence_id",
        "event_id",
        "run_id",
        "tester_id",
        "lot_id",
        "wafer_id",
        "site",
        "test_name",
        "unit",
        "sample_count",
        "observed",
        "baseline",
        "threshold",
        "metric",
        "series",
        "missing_fields"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "response_status"
            ],
            "properties": {
              "response_status": {
                "const": "tester_confirmed"
              }
            }
          },
          "then": {
            "required": [
              "tester_receipt_id"
            ],
            "properties": {
              "tester_receipt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        }
      ]
    },
    "prediction": {
      "type": "object",
      "properties": {
        "type": {
          "const": "prediction"
        },
        "prediction_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tester_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "wafer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "site": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "stage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "predicted": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "actual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "maxLength": 32
        },
        "coverage": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "response_status": {
          "enum": [
            "not_requested",
            "insufficient_data",
            "response_queued",
            "tester_confirmed",
            "unknown"
          ]
        },
        "tester_receipt_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "source_mode": {
          "enum": [
            "simulation",
            "replay",
            "live"
          ]
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "original_request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "source_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "type",
        "prediction_id",
        "event_id",
        "run_id",
        "tester_id",
        "lot_id",
        "wafer_id",
        "site",
        "device_id",
        "stage",
        "requested_at",
        "predicted",
        "actual",
        "unit",
        "coverage",
        "latency_ms",
        "model_version",
        "response_status",
        "tester_receipt_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "response_status": {
                "const": "tester_confirmed"
              }
            }
          },
          "then": {
            "properties": {
              "tester_receipt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        }
      ]
    },
    "incident": {
      "type": "object",
      "properties": {
        "type": {
          "const": "incident"
        },
        "incident_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tester_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "wafer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "site": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "enum": [
            "open",
            "investigating",
            "resolved"
          ]
        },
        "severity": {
          "enum": [
            "warning",
            "critical"
          ]
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "minItems": 1,
          "maxItems": 40
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "maxItems": 40
        },
        "first_seen": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "incident_id",
        "run_id",
        "tester_id",
        "lot_id",
        "wafer_id",
        "site",
        "title",
        "status",
        "severity",
        "event_ids",
        "evidence_ids",
        "first_seen"
      ],
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tester_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "const": "tester_message"
        },
        "incident_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "command_id",
        "run_id",
        "tester_id",
        "kind",
        "incident_id",
        "message",
        "created_at",
        "expires_at"
      ],
      "additionalProperties": false,
      "description": "expires_at must follow created_at; enforced by runtime semantic validation."
    },
    "command_ack": {
      "type": "object",
      "properties": {
        "type": {
          "const": "command_ack"
        },
        "ack_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tester_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "enum": [
            "received",
            "queued_to_tester",
            "tester_confirmed",
            "rejected",
            "failed",
            "expired"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "tester_receipt_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "type",
        "ack_id",
        "command_id",
        "run_id",
        "tester_id",
        "status",
        "occurred_at",
        "tester_receipt_id",
        "detail"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "tester_confirmed"
              }
            }
          },
          "then": {
            "properties": {
              "tester_receipt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        }
      ]
    },
    "batch": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1-draft"
        },
        "batch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "records": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/event"
              },
              {
                "$ref": "#/$defs/evidence"
              },
              {
                "$ref": "#/$defs/prediction"
              },
              {
                "$ref": "#/$defs/incident"
              },
              {
                "$ref": "#/$defs/command_ack"
              }
            ]
          },
          "minItems": 1,
          "maxItems": 200
        },
        "source_batch": {
          "$ref": "#/$defs/ui_edge_batch",
          "description": "Original normalized wire batch; retained for identity conflicts and provenance, including actual events."
        }
      },
      "required": [
        "schema_version",
        "batch_id",
        "sent_at",
        "records"
      ],
      "additionalProperties": false
    },
    "ui_edge_batch": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://grp6.invalid/contracts/ui-edge-v1.schema.json",
      "title": "UI input compatibility for D projected Edge v1 records",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "edge_id",
        "batch_id",
        "events"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "edge_id": {
          "$ref": "#/$defs/id"
        },
        "batch_id": {
          "$ref": "#/$defs/id"
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      },
      "$defs": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "site": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "event_id",
            "type",
            "source_mode",
            "run_id",
            "tester_id",
            "timestamp"
          ],
          "properties": {
            "event_id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "enum": [
                "measurement",
                "prediction",
                "prediction_actual",
                "evidence",
                "heartbeat",
                "run_summary"
              ]
            },
            "source_mode": {
              "enum": [
                "live",
                "replay",
                "simulation"
              ]
            },
            "run_id": {
              "$ref": "#/$defs/id"
            },
            "tester_id": {
              "$ref": "#/$defs/id"
            },
            "lot_id": {
              "$ref": "#/$defs/id"
            },
            "wafer_id": {
              "$ref": "#/$defs/id"
            },
            "device_id": {
              "$ref": "#/$defs/id"
            },
            "site_id": {
              "$ref": "#/$defs/site"
            },
            "site_ids": {
              "type": "array",
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/site"
              }
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
            },
            "test_number": {
              "type": "integer"
            },
            "test_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "pin": {
              "type": "string",
              "maxLength": 120
            },
            "value": {
              "type": "number"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 32
            },
            "quality": {
              "type": "string",
              "maxLength": 32
            },
            "request_id": {
              "$ref": "#/$defs/id"
            },
            "stage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "prediction": {
              "type": [
                "number",
                "null"
              ]
            },
            "actual": {
              "type": "number"
            },
            "absolute_error": {
              "type": "number",
              "minimum": 0
            },
            "model_version": {
              "$ref": "#/$defs/id"
            },
            "feature_cutoff": {
              "type": "integer"
            },
            "latency_ms": {
              "type": "number",
              "minimum": 0
            },
            "coverage": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "response_status": {
              "enum": [
                "not_requested",
                "insufficient_data",
                "response_queued",
                "tester_confirmed",
                "unknown"
              ]
            },
            "tester_receipt_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "evidence_id": {
              "$ref": "#/$defs/id"
            },
            "incident_id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "direction": {
              "type": "string",
              "maxLength": 32
            },
            "sample_count": {
              "type": "integer",
              "minimum": 0
            },
            "score": {
              "type": "number"
            },
            "baseline": {
              "type": "number"
            },
            "current_value": {
              "type": "number"
            },
            "threshold": {
              "type": "number"
            },
            "affected_tests": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            },
            "series": {
              "type": "array",
              "maxItems": 320,
              "items": {
                "type": "number"
              }
            },
            "site_series": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "maxItems": 320,
                "items": {
                  "type": "number"
                }
              }
            },
            "suggestion": {
              "type": "string",
              "maxLength": 1000
            },
            "severity": {
              "enum": [
                "info",
                "warning",
                "critical"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 2000
            },
            "completed_devices": {
              "type": "integer",
              "minimum": 0
            },
            "yield": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "data_quality": {
              "enum": [
                "complete",
                "partial"
              ]
            },
            "queue_depth": {
