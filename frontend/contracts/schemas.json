{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/batch",
  "$defs": {
    "event": {
      "type": "object",
      "properties": {
        "type": {
          "const": "event"
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "enum": [
            "simulation",
            "replay",
            "live"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tester_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "wafer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "site": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "kind": {
          "enum": [
            "normal",
            "mean_drift",
            "low_yield",
            "missing_data",
            "measurement",
            "prediction",
            "external_evidence",
            "heartbeat",
            "run_summary"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "incident_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 20
        },
        "data_quality": {
          "enum": [
            "complete",
            "partial"
          ]
        }
      },
      "required": [
        "type",
        "event_id",
        "occurred_at",
        "mode",
        "run_id",
        "tester_id",
        "lot_id",
        "wafer_id",
        "site",
        "severity",
        "kind",
        "message",
        "incident_id",
        "evidence_ids",
        "data_quality"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "type": {
          "const": "evidence"
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tester_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "wafer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "site": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "test_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "metric": {
          "enum": [
            "mean",
            "yield",
            "coverage",
            "measurement"
          ]
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0
              },
              "value": {
                "type": "number"
              }
            },
            "required": [
              "index",
              "value"
            ],
            "additionalProperties": false
          },
          "maxItems": 160
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "maxItems": 32
        }
      },
      "required": [
        "type",
        "evidence_id",
        "event_id",
        "run_id",
        "tester_id",
        "lot_id",
        "wafer_id",
        "site",
        "test_name",
        "unit",
        "sample_count",
        "observed",
        "baseline",
        "threshold",
        "metric",
        "series",
        "missing_fields"
      ],
      "additionalProperties": false
    },
    "prediction": {
      "type": "object",
      "properties": {
        "type": {
          "const": "prediction"
        },
        "prediction_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tester_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "wafer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "site": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "device_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "stage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "requested_at": {
          "type": "string",
          "format": "date-time"
        },
        "predicted": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "actual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "type": "string",
          "maxLength": 32
        },
        "coverage": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "response_status": {
          "enum": [
            "not_requested",
            "insufficient_data",
            "response_queued",
            "tester_confirmed",
            "unknown"
          ]
        },
        "tester_receipt_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "prediction_id",
        "event_id",
        "run_id",
        "tester_id",
        "lot_id",
        "wafer_id",
        "site",
        "device_id",
        "stage",
        "requested_at",
        "predicted",
        "actual",
        "unit",
        "coverage",
        "latency_ms",
        "model_version",
        "response_status",
        "tester_receipt_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "response_status": {
                "const": "tester_confirmed"
              }
            }
          },
          "then": {
            "properties": {
              "tester_receipt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        }
      ]
    },
    "incident": {
      "type": "object",
      "properties": {
        "type": {
          "const": "incident"
        },
        "incident_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tester_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "lot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "wafer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "site": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "enum": [
            "open",
            "investigating",
            "resolved"
          ]
        },
        "severity": {
          "enum": [
            "warning",
            "critical"
          ]
        },
        "event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 1,
          "maxItems": 40
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 40
        },
        "first_seen": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "type",
        "incident_id",
        "run_id",
        "tester_id",
        "lot_id",
        "wafer_id",
        "site",
        "title",
        "status",
        "severity",
        "event_ids",
        "evidence_ids",
        "first_seen"
      ],
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tester_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "const": "tester_message"
        },
        "incident_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "command_id",
        "run_id",
        "tester_id",
        "kind",
        "incident_id",
        "message",
        "created_at",
        "expires_at"
      ],
      "additionalProperties": false,
      "description": "expires_at must follow created_at; enforced by runtime semantic validation."
    },
    "command_ack": {
      "type": "object",
      "properties": {
        "type": {
          "const": "command_ack"
        },
        "ack_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tester_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "status": {
          "enum": [
            "edge_received",
            "edge_executed",
            "tester_confirmed",
            "failed",
            "expired"
          ]
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "tester_receipt_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "type",
        "ack_id",
        "command_id",
        "run_id",
        "tester_id",
        "status",
        "occurred_at",
        "tester_receipt_id",
        "detail"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "tester_confirmed"
              }
            }
          },
          "then": {
            "properties": {
              "tester_receipt_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        }
      ]
    },
    "batch": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "0.1-draft"
        },
        "batch_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "sent_at": {
          "type": "string",
          "format": "date-time"
        },
        "records": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/event"
              },
              {
                "$ref": "#/$defs/evidence"
              },
              {
                "$ref": "#/$defs/prediction"
              },
              {
                "$ref": "#/$defs/incident"
              },
              {
                "$ref": "#/$defs/command_ack"
              }
            ]
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "schema_version",
        "batch_id",
        "sent_at",
        "records"
      ],
      "additionalProperties": false
    }
  }
}
