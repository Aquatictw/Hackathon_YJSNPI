# Server-only. Never use NEXT_PUBLIC_ or VITE_ prefixes for secrets.
OPENAI_API_KEY=
# Set to a Responses-compatible model available to your OpenAI project.
OPENAI_MODEL=gpt-6-astra
# Long random server-side token used only by the Edge exporter.
INGEST_TOKEN=
# Separate token for polling commands and reporting delivery results.
COMMAND_TOKEN=
